{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "angles-web",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "vars": {
    "ANGLES_API_BASE_URL": "https://api-production-61c9.up.railway.app"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "useangles.app",
      "custom_domain": true
    },
    {
      "pattern": "www.useangles.app",
      "custom_domain": true
    }
  ]
}
