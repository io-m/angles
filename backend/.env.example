PORT=8787
LLM_MODEL=mistral-small-latest
MISTRAL_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# Metered public model options: mistral-small-latest (default), gemini-3.8-flash,
# deepseek-flash. deepseek-v4-pro is intentionally unavailable to metered requests.
# Production requires keys for all three public providers, without making a startup
# network call. Local development only needs the key for the model it uses.

# Local Postgres via `docker compose up -d` from the repo root (host port 5433).
# Production applies the packaged Drizzle migrations before checking schema/startup.
# Signs every /reframe result so POST /cards only stores what the server cooked.
# At least 32 characters: `openssl rand -base64 32`. Rotating it invalidates unsaved cooks.
COOK_SIGNING_KEY=
# Separate key for text-free request fingerprints and idempotency checks.
METERING_HMAC_KEY=

DATABASE_URL=postgres://angles:angles@127.0.0.1:5433/angles
DATABASE_URL_TEST=postgres://angles:angles@127.0.0.1:5433/angles_test

# Better Auth (at least 32 characters: `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Public URL the iPhone uses to reach this API (Debug LAN IP).
# Production requires an HTTPS URL and a real, non-placeholder Apple client secret.
BETTER_AUTH_URL=http://192.168.0.39:8787
# Native Sign in with Apple: Services ID or bundle id, and a client-secret JWT.
APPLE_CLIENT_ID=app.angles.ios
APPLE_CLIENT_SECRET=

# StoreKit server entitlement enforcement. Keep off for local development/tests;
# production must set this exact value to require a subscription after the free taste.
SUBSCRIPTION_ENFORCEMENT=off
# Credit, taste, idempotency, and usage-limit enforcement. Keep off locally/tests.
# Production must set this exact value.
USAGE_ENFORCEMENT=off
# Comma-separated base64 DER Apple root certificates, or a JSON array of base64 strings.
# Download public roots from Apple PKI. These are certificates, not private keys.
APPLE_ROOT_CERTIFICATES_BASE64=
# Numeric App Store Connect Apple App ID. Optional for sandbox-only local work;
# required to verify production transactions and Server Notifications V2.
APPLE_APP_ID=

# Railway bucket angles-avatars (private). Names match the bucket variable references.
# Local API only; values live in .env, never here.
# Production requires every bucket variable; ENDPOINT must be HTTPS and S3_URL_STYLE
# must be exactly virtual-hosted or path.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
ENDPOINT=
# virtual-hosted (Railway default) or path
S3_URL_STYLE=
