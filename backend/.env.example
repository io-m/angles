PORT=8787
LLM_MODEL=mistral-small-latest
MISTRAL_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# LLM_MODEL options: mistral-small-latest (default), gemini-3.8-flash,
# deepseek-flash, deepseek-v4-pro (routes to Flash after 14 Sep 2026).

# Local Postgres via `docker compose up -d` from the repo root (host port 5433).
DATABASE_URL=postgres://angles:angles@127.0.0.1:5433/angles
DATABASE_URL_TEST=postgres://angles:angles@127.0.0.1:5433/angles_test

# Future — Better Auth. Do not use until the auth task.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
