{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": true,
    "types": ["node"]
  },
  "files": [
    "src/scripts/reports.ts",
    "src/scripts/seedLiveCooks.ts",
    "src/scripts/feedAudit.ts",
    "src/scripts/graveHumor.ts"
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/scripts/**"]
}
